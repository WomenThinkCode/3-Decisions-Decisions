<+>package org.example;\n\npublic class ShadyRestRoom {\n    public static void main(String[] args) {\n        Scanner scn = new Scanner(System.in);\n        int room = scn.nextInt();\n        System.out.println(\"Hello and Welcome to ShadySide Hotel. Let's get your room set up.\");\n        System.out.println(\"1. a queen sized bed\");\n        System.out.println(\"2. a king sized bed\");\n        System.out.println(\"3. a king sized bed and pullout couch\");\n        System.out.println(\"Please choose from options 1, 2 or 3\");\n\n        switch(room) {\n            case 1:\n                System.out.println(\"This room costs R500.\");\n                break;\n            case 2:\n                System.out.println(\"This room costs R700.\");\n                break;\n            case 3:\n                System.out.println(\"This room costs R900.\");\n                break;\n            default:\n                System.out.println(\"That choice does not exist. It costs R0\");\n        }\n\n        Scanner.close();\n    }\n}
