package org.example;

public class ShadyRestRoom {
    public static void main(String[] args) {
        Scanner scn = new Scanner(System.in);
        int room = scn.nextInt();
        System.out.println("Hello and Welcome to ShadySide Hotel. Let's get your room set up.");
        System.out.println("1. a queen sized bed");
        System.out.println("2. a king sized bed");
        System.out.println("3. a king sized bed and pullout couch");
        System.out.println("Please choose from options 1, 2 or 3");

        switch(room) {
            case 1:
                System.out.println("This room costs R500.");
                break;
            case 2:
                System.out.println("This room costs R700.");
                break;
            case 3:
                System.out.println("This room costs R900.");
                break;
            default:
                System.out.println("That choice does not exist. It costs R0");
        }

        Scanner.close();
    }
}